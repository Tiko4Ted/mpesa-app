generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id          String   @id @default(uuid())
  name        String
  phoneNumber String   @unique
  pin         String
  balance     Float    @default(0.0)
  fuliza      Float    @default(0.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
